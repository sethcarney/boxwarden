{
  "name": "boxwarden",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local dev container management: lists the dev containers on your machine and reattaches your editor to them.",
  "author": "Seth Carney <48496865+sethcarney@users.noreply.github.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sethcarney/boxwarden.git"
  },
  "main": "out/main/index.js",
  "desktopName": "boxwarden.desktop",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dev:fake": "BOXWARDEN_FAKE_DOCKER=1 electron-vite dev",
    "devcontainer:open": "node scripts/devcontainer-open.mjs",
    "package": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:win": "electron-vite build && electron-builder --win",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run check:devcontainer",
    "check:devcontainer": "node scripts/check-devcontainer.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-mvvm": "^1.0.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7",
    "vitest": "^4.1.10"
  },
  "trustedDependencies": [
    "electron",
    "esbuild"
  ],
  "dependencies": {
    "dockerode": "^5.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
